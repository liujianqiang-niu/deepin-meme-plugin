{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deepin Meme Plugin Theme Manifest Schema",
  "description": "特效主题包清单文件格式定义",
  "type": "object",
  "required": ["id", "name", "version", "wallpaper", "effects"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "主题唯一标识,小写字母数字横线"
    },
    "name": { "type": "string", "description": "显示名称" },
    "description": { "type": "string", "description": "主题描述" },
    "version": { "type": "string", "description": "主题版本号" },
    "author": { "type": "string", "description": "作者" },
    "wallpaper": {
      "type": "string",
      "description": "循环壁纸视频文件相对路径"
    },
    "thumbnail": {
      "type": "string",
      "description": "缩略图文件相对路径"
    },
    "effects": {
      "type": "object",
      "description": "各操作对应的特效配置,键为操作类型",
      "properties": {
        "delete": { "$ref": "#/definitions/effect" },
        "create": { "$ref": "#/definitions/effect" },
        "rename": { "$ref": "#/definitions/effect" },
        "move": { "$ref": "#/definitions/effect" },
        "copy": { "$ref": "#/definitions/effect" }
      },
      "additionalProperties": { "$ref": "#/definitions/effect" }
    }
  },
  "definitions": {
    "effect": {
      "type": "object",
      "required": ["video"],
      "properties": {
        "video": { "type": "string", "description": "特效视频文件相对路径(推荐 webm 带 alpha)" },
        "audio": { "type": "string", "description": "音效文件相对路径(wav/ogg/mp3)" },
        "anchor": {
          "type": "string",
          "enum": ["target", "screen-center", "corner-tl"],
          "default": "target",
          "description": "特效锚点: target=对准文件坐标, screen-center=屏幕中心"
        },
        "scale": { "type": "number", "default": 1.0, "description": "缩放系数" },
        "duration": { "type": "integer", "default": 3000, "description": "持续时长(毫秒)" }
      }
    }
  }
}

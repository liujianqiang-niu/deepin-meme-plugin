#!/bin/sh
# SPDX-FileCopyrightText: 2026 UnionTech Software Technology Co., Ltd.
# SPDX-License-Identifier: GPL-3.0-or-later
# Post-installation: reload D-Bus, enable systemd user service

set -e

case "$1" in
    configure)
        # Reload D-Bus session services so org.deepin.meme.daemon is recognized
        if command -v dbus-send >/dev/null 2>&1; then
            dbus-send --session --dest=org.freedesktop.DBus \
                --type=method_call /org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig 2>/dev/null || true
        fi

        # Reload systemd user units (best effort)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user daemon-reload 2>/dev/null || true
        fi

        # Reload dconfig schema
        if command -v dconfig >/dev/null 2>&1; then
            dconfig reload 2>/dev/null || true
        fi
        ;;
esac

# dh_installdeb will call this automatically
#DEBHELPER#

#!/bin/sh
# SPDX-FileCopyrightText: 2026 UnionTech Software Technology Co., Ltd.
# SPDX-License-Identifier: GPL-3.0-or-later
# Post-installation: restart desktop edge plugin to load new wallpaper plugin

set -e

case "$1" in
    configure)
        # Restart dde-shell desktop service to load the edge plugin
        for uid in $(ls /run/user 2>/dev/null || true); do
            case "$uid" in *[!0-9]*) continue ;; esac
            [ -S "/run/user/$uid/bus" ] || continue
            user=$(getent passwd "$uid" | cut -d: -f1)
            su -s /bin/sh -c "XDG_RUNTIME_DIR=/run/user/$uid \
                DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus \
                timeout 8 systemctl --user restart \
                'dde-shell-plugin@org.deepin.ds.desktop.service'" "$user" 2>/dev/null || true
        done
        ;;
esac

#DEBHELPER#
exit 0

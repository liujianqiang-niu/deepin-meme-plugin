#!/bin/sh
# SPDX-FileCopyrightText: 2026 UnionTech Software Technology Co., Ltd.
# SPDX-License-Identifier: GPL-3.0-or-later
# Pre-removal: stop daemon, disable autostart

set -e

case "$1" in
    remove|deconfigure)
        # Stop running daemon instances
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user stop deepin-meme-daemon.service 2>/dev/null || true
            systemctl --user disable deepin-meme-daemon.service 2>/dev/null || true
        fi
        # Fallback: kill by process name
        pkill -f deepin-meme-daemon 2>/dev/null || true
        ;;
esac

#DEBHELPER#

# Pre-removal: disable wallpaper via DConfig

set -e

case "$1" in
    remove|deconfigure)
        # Best-effort: disable dynamic wallpaper before removing plugin
        if command -v dconfig-cli >/dev/null 2>&1; then
            dconfig-cli set -d org.deepin.meme -k enabled -v false 2>/dev/null || true
        fi
        ;;
esac

#DEBHELPER#
exit 0
